{
  "orchestrator": {
    "model": "gpt-6-sol",
    "reasoning_effort": "medium"
  },
  "worker": {
    "model": "gpt-6-sol",
    "parallel_limit": 3,
    "sandbox": "workspace-write",
    "bypass_approvals": false,
    "sandbox_permissions": [],
    "network_access": false,
    "reasoning_effort": "high"
  },
  "analysis": {
    "max_iterations": 12,
    "extraction_timeout_sec": 300,
    "max_specialist_tasks_per_run": 60,
    "scan_files_per_task": 4,
    "deep_research_enabled": true,
    "research_minutes": 0,
    "sessions_dir": "./sessions/investigator"
  },
  "report": {
    "output_dir": "./report",
    "language": "ko"
  },
  "mcp": {
    "apply_to": [
      "orchestrator",
      "worker"
    ],
    "servers": []
  }
}
