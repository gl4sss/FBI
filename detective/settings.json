{
  "orchestrator": {
    "model": "gpt-6-sol",
    "reasoning_effort": "medium"
  },
  "worker": {
    "model": "gpt-6-sol",
    "parallel_limit": 2,
    "bypass_approvals": false,
    "sandbox_permissions": [],
    "network_access": false,
    "reasoning_effort": "high"
  },
  "analysis": {
    "max_iterations": 6,
    "sessions_dir": "./sessions/detective"
  },
  "qemu": {
    "timeout_boot": 30,
    "timeout_poc": 60,
    "network_mode": "user",
    "telnet_port": 4444,
    "monitor_port": 4445,
    "poc_output_dir": "./poc_artifacts"
  },
  "report": {
    "output_dir": "./report",
    "language": "ko"
  },
  "mcp": {
    "apply_to": [
      "orchestrator",
      "worker"
    ],
    "servers": []
  }
}
