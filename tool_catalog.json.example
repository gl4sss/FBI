{
  "aliases": {
    "binwalk_extract": {
      "binary": "binwalk",
      "args": ["--extract", "--directory", "{output_dir}", "{input_file}"],
      "purpose": "Extract firmware and nested image containers",
      "mode": "automatic"
    },
    "squashfs_extract": {
      "binary": "unsquashfs",
      "args": ["-quiet", "-no-progress", "-no-xattrs", "-ignore-errors", "-dest", "{output_dir}", "{input_file}"],
      "purpose": "Expand SquashFS images into reviewable files",
      "mode": "automatic"
    },
    "hexagon_disassemble": {
      "binary": "llvm-objdump",
      "args": ["--disassemble", "{input_file}"],
      "fallback_paths": [
        "/opt/homebrew/opt/llvm/bin/llvm-objdump",
        "/usr/local/opt/llvm/bin/llvm-objdump"
      ],
      "purpose": "Disassemble Qualcomm Hexagon ELF code",
      "mode": "automatic"
    },
    "xtensa_disassemble": {
      "binary": "r2",
      "args": ["-q", "-e", "scr.color=false", "-a", "xtensa", "-b", "32", "-c", "s entry0; pd 32", "{input_file}"],
      "purpose": "Inspect Xtensa ELF instructions at the entry point",
      "mode": "automatic"
    },
    "mbn_inspect": {
      "binary": "rabin2",
      "args": ["-Ij", "{input_file}"],
      "purpose": "Identify ELF and Qualcomm MBN image metadata",
      "mode": "automatic"
    },
    "ghidra_review": {
      "binary": "ghidraRun",
      "args": [],
      "purpose": "Review Xtensa or Hexagon code in Ghidra",
      "mode": "manual"
    }
  },
  "targets": {
    "firmware_image": ["binwalk_extract"],
    "nested_image": ["binwalk_extract"],
    "squashfs": ["squashfs_extract"],
    "hexagon_elf": ["hexagon_disassemble", "mbn_inspect", "ghidra_review"],
    "xtensa_elf": ["xtensa_disassemble", "mbn_inspect", "ghidra_review"],
    "mbn_image": ["mbn_inspect", "ghidra_review"],
    "unidentified_elf": ["mbn_inspect", "ghidra_review"]
  }
}
